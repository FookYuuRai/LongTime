<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.longtime" name="LongTime" version="1.0.1" provider-name="LongTime">
	<requires>
		<import addon="xbmc.addon" version="12.0.0"/>
	</requires>
	<extension point="xbmc.addon.repository" name="LongTime">
		<dir>
			<info compressed="false">@BASE@addons.xml</info>
			<checksum>@BASE@addons.xml.md5</checksum>
			<datadir zip="true">@BASE@</datadir>
		</dir>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Add-on repository</summary>
		<description lang="en_GB">Installs and updates the add-ons in this repository.</description>
		<platform>all</platform>
	</extension>
</addon>
